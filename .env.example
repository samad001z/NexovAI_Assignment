# ElevenLabs: https://elevenlabs.io/app/settings/api-keys (needs Speech to Text + Text to Speech access)
ELEVENLABS_API_KEY=your-elevenlabs-key

# Google Gemini: https://aistudio.google.com/apikey (free tier works)
GOOGLE_API_KEY=your-gemini-key

# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite     # default; ~1 s per turn. Bigger Flash models were 4-18 s and hit 503s
# GEMINI_BACKUP_MODEL=gemini-3-flash-preview   # asked too when the main model hasn't answered within 1 s
# ELEVENLABS_VOICE_ID=8qPG2eSETnKl5ezq52Js   # Asha speaks as Tara (Indian English + Hindi)
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODE=realtime           # or "batch" if realtime STT isn't on your plan
# STT_ENGINE=elevenlabs                  # default; "whisper" runs Whisper locally (pip install -r server/requirements-whisper.txt)
# WHISPER_DEVICE=auto                    # auto tries cuda then cpu; or force "cpu" / "cuda"
# WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
